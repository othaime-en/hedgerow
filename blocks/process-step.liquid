{% doc %}
  A single step in sections/process-steps.liquid: step number, title,
  short description, and an optional image. Connected to the next step
  by a horizontal line on desktop (vertical stack on mobile).

  @example
  {% content_for 'block', type: 'process-step', id: 'step-1' %}
{% enddoc %}

<div class="process-step" {{ block.shopify_attributes }}>
  {% if block.settings.image != blank %}
    <div class="process-step__media">
      {{
        block.settings.image
        | image_url: width: 600
        | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 20vw, 50vw', widths: '300, 450, 600'
      }}
    </div>
  {% endif %}
  <span class="process-step__number text-2xl">{{ block.settings.step_number }}</span>
  {% if block.settings.heading != blank %}
    <h3 class="process-step__heading text-lg">{{ block.settings.heading }}</h3>
  {% endif %}
  {% if block.settings.description != blank %}
    <p class="process-step__description text-sm">{{ block.settings.description }}</p>
  {% endif %}
</div>

{% stylesheet %}
  .process-step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-sand);
  }

  .process-step__media {
    width: 100%;
    aspect-ratio: 1 / 1;
    margin-bottom: var(--space-2);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .process-step__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .process-step__number {
    font-family: var(--font-display);
    color: var(--color-clay);
  }
  .process-step__description {
    color: var(--color-ink-muted);
  }

  /* On desktop, the top border reads as the connecting "timeline" line
     running behind every step in the row. */
  @media (min-width: 750px) {
    .process-step {
      padding-top: var(--space-5);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.process_step",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "step_number",
      "label": "t:labels.step_number",
      "default": "01"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description"
    }
  ],
  "presets": [{ "name": "t:general.process_step" }]
}
{% endschema %}
