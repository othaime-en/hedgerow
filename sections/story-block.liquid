{% comment %}
  Phase 6 — the generic "story/text-image block" named in the
  implementation plan for flexible content pages. Structurally this is
  featured-collection-story.liquid's layout (image + eyebrow/heading/
  body/CTA column, alternating sides) with the collection-fallback
  logic removed, since content pages like "Our Story" or "How It's
  Made" aren't tied to a single collection. The two sections share a
  look on purpose — same grid, same class conventions where they
  overlap — but are kept as separate files because their data sources
  genuinely differ (this one is pure section settings; the other reads
  collection/metafield data first).

  @example
  Stack two of these with alternating `image_position` for an
  About page: one introducing the founding idea, one on process.
{% endcomment %}

<div
  class="story-block story-block--{{ section.settings.background }} full-width section-padding"
  style="{% render 'section-padding', section: section %}"
>
  <div class="story-block__inner container story-block--{{ section.settings.image_position }}">
    <div class="story-block__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '500, 800, 1100, 1400'
        }}
      {% else %}
        <div class="story-block__placeholder"></div>
      {% endif %}
    </div>

    <div class="story-block__content">
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="text-2xl">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.story != blank %}
        <p class="text-lg story-block__story">{{ section.settings.story }}</p>
      {% endif %}
      {% if section.settings.cta_text != blank %}
        <a href="{{ section.settings.cta_link | default: '#' }}" class="button button--primary story-block__cta">
          {{ section.settings.cta_text }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .story-block--surface {
    background-color: var(--color-surface);
  }
  .story-block--bg {
    background-color: var(--color-bg);
  }

  .story-block__inner {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .story-block__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }
  .story-block__placeholder {
    width: 100%;
    aspect-ratio: 4 / 5;
    background-color: var(--color-sand);
    border-radius: var(--radius-lg);
  }

  .story-block__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .story-block__story {
    color: var(--color-ink-muted);
    max-width: 46ch;
  }
  .story-block__cta {
    width: auto;
    padding-inline: var(--space-5);
    margin-top: var(--space-2);
  }

  @media (min-width: 750px) {
    .story-block__inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
    .story-block--right .story-block__media {
      order: 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.story_block",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:labels.image_position",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:labels.background",
      "options": [
        { "value": "bg", "label": "t:options.background_style.bg" },
        { "value": "surface", "label": "t:options.background_style.surface" }
      ],
      "default": "bg"
    },
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "textarea",
      "id": "story",
      "label": "t:labels.story"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "t:labels.cta_text"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:labels.cta_link"
    },
    {
      "type": "header",
      "content": "t:general.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [{ "name": "t:general.story_block" }]
}
{% endschema %}
