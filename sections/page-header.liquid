{% comment %}
  Phase 6 — flexible content-page header. A single-image (or plain,
  image-less) banner used at the top of "Our Story," "How It's Made,"
  "Sustainability," and similar pages so those pages don't have to
  reuse `page.liquid`'s bare `<h1>{{ page.title }}</h1>` treatment.

  Reuses the same scrim / text_color / eyebrow--inverse pattern as
  blocks/hero-slide.liquid so an image-backed page header looks like
  part of the same design system as the homepage hero, rather than a
  one-off. Unlike the hero, this is a single static banner — no slide
  blocks, no auto-rotate — a page header doesn't need a carousel.
{% endcomment %}

{% liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = page.title
  endif
%}

<div
  class="page-header page-header--{{ section.settings.height }} full-width section-padding {% if section.settings.image != blank %}page-header--has-image{% endif %}"
  style="{% render 'section-padding', section: section %}"
>
  {% if section.settings.image != blank %}
    <div class="page-header__media">
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag: loading: 'eager', sizes: '100vw', widths: '750, 1100, 1500, 2000'
      }}
      {% if section.settings.scrim %}
        <div class="page-header__scrim"></div>
      {% endif %}
    </div>
  {% endif %}

  <div class="page-header__content page-header__content--{{ section.settings.text_color }}">
    {% if section.settings.eyebrow != blank %}
      <span class="eyebrow {% if section.settings.image != blank %}eyebrow--inverse{% endif %} page-header__eyebrow">
        {{ section.settings.eyebrow }}
      </span>
    {% endif %}
    {% if heading != blank %}
      <h1 class="page-header__heading text-2xl">{{ heading }}</h1>
    {% endif %}
    {% if section.settings.subtext != blank %}
      <p class="page-header__subtext text-lg">{{ section.settings.subtext }}</p>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .page-header {
    position: relative;
    display: flex;
    align-items: flex-end;
  }

  .page-header:not(.page-header--has-image) {
    align-items: flex-start;
    background-color: var(--color-surface);
  }

  .page-header--compact:not(.page-header--has-image) {
    min-height: 0;
  }

  .page-header--has-image.page-header--compact {
    min-height: 40vh;
  }
  .page-header--has-image.page-header--standard {
    min-height: 56vh;
  }

  .page-header__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .page-header__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .page-header__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(46, 42, 38, 0.6), rgba(46, 42, 38, 0) 60%);
    pointer-events: none;
  }

  .page-header__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    max-width: 42rem;
    padding: var(--space-5) var(--page-margin);
  }

  .page-header__content--light .page-header__heading,
  .page-header__content--light .page-header__subtext {
    color: var(--color-white);
  }
  .page-header__content--dark .page-header__heading,
  .page-header__content--dark .page-header__subtext {
    color: var(--color-ink);
  }

  .page-header__subtext {
    color: var(--color-ink-muted);
    max-width: 48ch;
  }
  .page-header__content--light .page-header__subtext {
    color: var(--color-white);
    opacity: 0.9;
  }

  @media (min-width: 750px) {
    .page-header__content {
      padding: var(--space-6) var(--page-margin);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.page_header",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:info.page_header_image"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:labels.height",
      "options": [
        { "value": "compact", "label": "t:options.height.compact" },
        { "value": "standard", "label": "t:options.height.standard" }
      ],
      "default": "compact"
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "t:labels.text_color",
      "options": [
        { "value": "light", "label": "t:options.text_color.light" },
        { "value": "dark", "label": "t:options.text_color.dark" }
      ],
      "default": "light",
      "info": "t:info.hero_text_color"
    },
    {
      "type": "checkbox",
      "id": "scrim",
      "label": "t:labels.scrim",
      "default": true,
      "info": "t:info.hero_scrim"
    },
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.page_header_heading"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "t:labels.subtext"
    },
    {
      "type": "header",
      "content": "t:general.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [{ "name": "t:general.page_header" }]
}
{% endschema %}
