
{% liquid
  assign review_count = 0
  assign rating_sum = 0
  for entry in shop.metaobjects.review.values
    if entry.product.value.id == product.id
      assign review_count = review_count | plus: 1
      assign rating_sum = rating_sum | plus: entry.rating.value
    endif
  endfor

  assign average_rating = 0
  if review_count > 0
    assign average_rating = rating_sum | times: 1.0 | divided_by: review_count | round: 1
  endif
%}

{% if review_count > 0 or request.design_mode %}
  <div class="product-reviews section-padding" style="{% render 'section-padding', section: section %}">
    <div class="container">
      <div class="product-reviews__header">
        {% if section.settings.heading != blank %}
          <h2 class="text-xl">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if review_count > 0 %}
          <div class="product-reviews__summary">
            <div class="product-reviews__stars" aria-hidden="true">
              {% assign rounded_rating = average_rating | round %}
              {% for i in (1..5) %}
                <span class="product-reviews__star{% if i > rounded_rating %} is-empty{% endif %}">
                  {{ 'icon-star.svg' | inline_asset_content }}
                </span>
              {% endfor %}
            </div>
            <span class="text-sm">
              {{ 'product.reviews_summary' | t: rating: average_rating, count: review_count }}
            </span>
          </div>
        {% endif %}
      </div>

      {% if review_count > 0 %}
        <div class="product-reviews__grid">
          {% comment %} Photo reviews first — Phase 5 directive #5 visual priority. {% endcomment %}
          {% for entry in shop.metaobjects.review.values %}
            {% if entry.product.value.id == product.id and entry.photo.value != blank %}
              {% render 'review-card',
                image: entry.photo.value,
                rating: entry.rating.value,
                quote: entry.quote.value,
                customer_name: entry.customer_name.value
              %}
            {% endif %}
          {% endfor %}
          {% for entry in shop.metaobjects.review.values %}
            {% if entry.product.value.id == product.id and entry.photo.value == blank %}
              {% render 'review-card',
                rating: entry.rating.value,
                quote: entry.quote.value,
                customer_name: entry.customer_name.value
              %}
            {% endif %}
          {% endfor %}
        </div>
      {% elsif request.design_mode %}
        <div class="product-reviews__empty-state">
          <p class="text-base">{{ 'product.reviews_empty_state' | t }}</p>
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .product-reviews__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .product-reviews__summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-ink-muted);
  }
  .product-reviews__stars {
    display: flex;
    gap: 2px;
  }
  .product-reviews__star svg {
    width: 0.85rem;
    height: 0.85rem;
    color: var(--color-clay);
  }
  .product-reviews__star.is-empty svg {
    color: var(--color-sand);
  }

  .product-reviews__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }
  @media (min-width: 750px) {
    .product-reviews__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-5);
    }
  }

  .product-reviews__empty-state {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 8rem;
    background-color: var(--color-surface);
    color: var(--color-ink-muted);
    border-radius: var(--radius-md);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product_reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "What customers are saying"
    },
    {
      "type": "header",
      "content": "t:general.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ]
}
{% endschema %}
